# Copy to .env for local development. Never commit the real .env.

DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Defaults to https:// plus each allowed host; set only to override.
# CSRF_TRUSTED_ORIGINS=https://resolvehub.example.com

# PostgreSQL connection string (Neon in production).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/resolvehub

# Object storage: "s3" for any S3-compatible provider (Garage in production;
# MinIO, R2, B2 and AWS S3 work too). "local" and "memory" are only accepted when
# DEBUG=True.
STORAGE_BACKEND=local
# S3_BUCKET_NAME=resolvehub-uploads
# S3_ENDPOINT_URL=https://files.example.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Garage: garage and path. MinIO: us-east-1 and path. R2: leave both unset.
# S3_REGION=garage
# S3_ADDRESSING_STYLE=path

# Form assistant (optional). Any OpenAI-compatible provider works.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=gpt-4o-mini

# Sign in with GitHub (optional). Callback URL to register on GitHub:
# https://<your-host>/accounts/github/login/callback/
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
