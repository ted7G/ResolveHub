# Copy to .env for local development. Never commit the real .env.

DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://resolvehub.example.com

# PostgreSQL connection string (Neon in production).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/resolvehub

# Object storage: "s3" for any S3-compatible provider (Cloudflare R2 in
# production). "local" and "memory" are only accepted when DEBUG=True.
STORAGE_BACKEND=local
# S3_BUCKET_NAME=resolvehub-uploads
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# Form assistant (optional). Any OpenAI-compatible provider works.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=gpt-4.1-mini

# Sign in with GitHub (optional). Callback URL to register on GitHub:
# https://<your-host>/accounts/github/login/callback/
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
